# Copy this file to .env and fill in the blanks. Do not commit .env.
# system/run loads .env without overriding variables already in the environment.

# Primary key. This is the only route the judges use (https://openrouter.ai/api/v1).
OPENROUTER_API_KEY=

# Optional fallback: direct Grok API (https://api.x.ai/v1). Used only when OPENROUTER_API_KEY is empty.
XAI_API_KEY=

# Optional model name overrides. Defaults shown are what the code uses when unset.
JEV_MODEL=typesafe/jev-router
GROK_MODEL=x-ai/grok-4
XAI_MODEL=grok-4

# Set to 1 to let Grok rephrase reasons. Leave empty to keep the template wording.
RESOLVE_POLISH_REASONS=
